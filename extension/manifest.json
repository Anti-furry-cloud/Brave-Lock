{
  "manifest_version": 3,
  "name": "Brave Lock",
  "version": "1.1.1",
  "description": "Adds .lock to completed downloads using a local Windows helper.",
  "permissions": [
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Brave Lock",
    "default_popup": "popup.html"
  },
  "key": "",
  "author": "Anti-furry-cloud"
}